{
  "name": "@miorin/dsh-next-actions",
  "version": "0.1.8",
  "license": "MIT",
  "description": "Suggested next actions under DeepSeek Harness replies; clicking one fills the input draft, never sends.",
  "icon": "./icon.svg",
  "author": "LighghtEeloo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-next-actions.git"
  },
  "homepage": "https://github.com/miorin-chan/dsh-next-actions#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-next-actions/issues"
  },
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "next-actions",
    "suggestions"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "DESIGN.md",
    "assets/*.svg",
    "README.md",
    "README.zh.md",
    "docs/README.md",
    "docs/development.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "src",
    "scripts",
    "tsconfig.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "check": "node --test && npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.31",
    "esbuild": "0.28.2",
    "react": "^18.3.1",
    "typescript": "5.7.3"
  }
}
